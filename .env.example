# Content Creator configuration. Copy to .env, fill in, restart. Never commit .env.

# ---- Required ----------------------------------------------------------------

# ModelArk API key: one key for Seed LLM, Seedream (images) and Seedance (video).
ARK_API_KEY=

# BytePlus access/secret key pair, used for TOS uploads.
BYTEPLUS_AK=
BYTEPLUS_SK=

# TOS bucket and region for uploaded media.
TOS_BUCKET_NAME=
TOS_REGION=ap-southeast-1

# ModelArk project and endpoint, used when registering uploaded media as assets.
ARK_PROJECT=default
ARK_MODEL_ENDPOINT=

# ---- Optional ----------------------------------------------------------------

# Public URL prefix for TOS objects (when the bucket sits behind a custom domain/CDN).
TOS_PUBLIC_URL_PREFIX=

# Seed Audio key (BytePlus Voice), used by Seed Audio 1.0.
# Seed Audio 1.5 is temporarily unavailable.
SEED_AUDIO_API_KEY=
SEED_AUDIO_MODEL=

# AI MediaKit key for the Video Enhancer (a separate BytePlus product key).
MEDIAKIT_API_KEY=

# Blender executable for Blender 3D (auto-detected when blank).
BLENDER_PATH=

# Ports to try in order (default 8000) and log level (DEBUG, INFO, WARNING, ERROR).
CONTENT_CREATOR_PORTS=
LOG_LEVEL=

# Rarely needed overrides (custom endpoints, TOS key prefix, regions)
# are listed under "Environment Variables" in README.md.
